# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# TiDB Cloud Serverless connection
# Get these from your TiDB Cloud cluster's "Connect" panel
DB_HOST=gateway01.xx-xxxxx.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=your_tidb_user
DB_PASSWORD=your_tidb_password
DB_NAME=bookbinding

# TiDB Cloud requires TLS. Set to true in production.
DB_SSL=true
# Optional path to a CA cert if your environment doesn't already trust TiDB's cert chain.
# Leave blank to use Node's default trusted CAs (works for most setups).
DB_SSL_CA=

# Cookie
COOKIE_NAME=bb_token
