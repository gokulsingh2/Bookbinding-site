<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Analytics — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
</head>
<body class="admin-body">
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">
      <%- include('partials/admin-nav') %>

      <div id="loadingState"><p>Loading analytics…</p></div>
      <div id="accessDenied" class="order-form__notice" style="display:none;">
        <p>Admin access required.</p>
        <a href="/login" class="btn btn--primary">Log in</a>
      </div>

      <div id="analyticsContent" style="display:none;">
        <h1>Analytics</h1>

        <div class="analytics-grid">
          <div class="chart-card">
            <h3>Orders per Month</h3>
            <canvas id="ordersChart"></canvas>
          </div>
          <div class="chart-card">
            <h3>Revenue Trend</h3>
            <canvas id="revenueChart"></canvas>
          </div>
          <div class="chart-card">
            <h3>Top Services</h3>
            <canvas id="servicesChart"></canvas>
          </div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/admin-analytics.js"></script>
</body>
</html>
