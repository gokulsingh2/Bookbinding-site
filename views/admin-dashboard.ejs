<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — Book Binding Co.</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">
      <%- include('partials/admin-nav') %>

      <div id="loadingState"><p>Loading dashboard…</p></div>
      <div id="accessDenied" class="order-form__notice" style="display:none;">
        <p>Admin access required.</p>
        <a href="/test-auth.html" class="btn btn--primary">Log in</a>
      </div>

      <div id="dashboardContent" style="display:none;">
        <h1>Dashboard</h1>

        <div class="stat-grid">
          <div class="stat-card"><span id="statTotal">0</span><label>Total Orders</label></div>
          <div class="stat-card"><span id="statReceived">0</span><label>Received</label></div>
          <div class="stat-card"><span id="statInProgress">0</span><label>In Progress</label></div>
          <div class="stat-card"><span id="statReady">0</span><label>Ready</label></div>
          <div class="stat-card"><span id="statDelivered">0</span><label>Delivered</label></div>
          <div class="stat-card"><span id="statRevenue">₹0</span><label>Estimated Revenue</label></div>
        </div>

        <h2 class="admin-section-title">Recent Orders</h2>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr><th>Order #</th><th>Customer</th><th>Service</th><th>Status</th><th>Price</th><th>Date</th></tr>
            </thead>
            <tbody id="recentOrdersBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/admin-dashboard.js"></script>
</body>
</html>
