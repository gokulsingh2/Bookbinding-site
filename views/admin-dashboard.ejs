<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css?v=32" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="admin-body">
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">

      <div id="loadingState"><p>Loading dashboard…</p></div>
      <div id="accessDenied" class="order-form__notice" style="display:none;">
        <p>Admin access required.</p>
        <a href="/login" class="btn btn--primary">Log in</a>
      </div>

      <div id="dashboardContent" style="display:none;">
        <h1>Dashboard</h1>

        <div class="stat-grid">
          <div class="stat-card stat-card--violet">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l5 5v13a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M15 3v5h5"/></svg></span>
            <span id="statTotal" class="stat-card__value">0</span>
            <label>Total Orders</label>
          </div>
          <div class="stat-card stat-card--blue">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/></svg></span>
            <span id="statReceived" class="stat-card__value">0</span>
            <label>Received</label>
          </div>
          <div class="stat-card stat-card--amber">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg></span>
            <span id="statInProgress" class="stat-card__value">0</span>
            <label>In Progress</label>
          </div>
          <div class="stat-card stat-card--green">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 6L9 17l-5-5"/></svg></span>
            <span id="statReady" class="stat-card__value">0</span>
            <label>Ready</label>
          </div>
          <div class="stat-card stat-card--stone">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="10" width="14" height="8" rx="1"/><path d="M17 13h2.5l1.5 2.5V18h-4"/><circle cx="7" cy="18.5" r="1.5"/><circle cx="17" cy="18.5" r="1.5"/></svg></span>
            <span id="statDelivered" class="stat-card__value">0</span>
            <label>Delivered</label>
          </div>
          <div class="stat-card stat-card--red">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 9v4M12 17h.01"/><path d="M10.3 3.9L2.5 17a1.5 1.5 0 001.3 2.3h16.4a1.5 1.5 0 001.3-2.3L13.7 3.9a1.5 1.5 0 00-2.6 0z"/></svg></span>
            <span id="statUrgent" class="stat-card__value">0</span>
            <label>Urgent Orders</label>
          </div>
          <div class="stat-card stat-card--teal">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
            <span id="statMessages" class="stat-card__value">0</span>
            <label>Contact Messages</label>
          </div>
          <div class="stat-card stat-card--revenue">
            <span class="stat-card__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2v20M17 5.5c0-1.4-2.2-2.5-5-2.5s-5 1.1-5 2.5 2.2 2.5 5 2.5 5 1.1 5 2.5-2.2 2.5-5 2.5-5-1.1-5-2.5"/></svg></span>
            <span id="statRevenue" class="stat-card__value">₹0</span>
            <label>Estimated Revenue</label>
          </div>
        </div>

        <h2 class="admin-section-title">Recent Orders</h2>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr><th>Order #</th><th>Customer</th><th>Service</th><th>Status</th><th>Price</th><th>Date</th></tr>
            </thead>
            <tbody id="recentOrdersBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/admin-dashboard.js"></script>
</body>
</html>
