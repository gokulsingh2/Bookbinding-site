<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Order Confirmation — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner section__inner--narrow">
      <div id="loadingState">
        <p>Loading your order…</p>
      </div>

      <div id="errorState" style="display:none;">
        <p id="errorMessage">We couldn't find that order.</p>
        <a href="/test-auth.html" class="btn btn--primary">Log in</a>
      </div>

      <div id="confirmationState" style="display:none;">
        <div class="confirmation__badge">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="11"/>
            <path d="M7 12.5l3.2 3.2L17 9"/>
          </svg>
          Order Confirmed
        </div>
        <div class="confirmation__heading-row">
          <h1 id="orderNumber"></h1>

          <div class="confirmation__stamp-row">
            <div class="order-stamp" id="orderStamp" aria-hidden="true">
            <span class="order-stamp__bleed order-stamp__bleed--1"></span>
            <span class="order-stamp__bleed order-stamp__bleed--2"></span>
            <span class="order-stamp__bleed order-stamp__bleed--3"></span>
            <span class="order-stamp__shock"></span>
            <svg viewBox="0 0 220 220" class="order-stamp__svg">
              <defs>
                <filter id="stampInkFine" x="-30%" y="-30%" width="160%" height="160%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n1"/>
                  <feDisplacementMap in="SourceGraphic" in2="n1" scale="1.4"/>
                </filter>
                <filter id="stampInkCoarse" x="-30%" y="-30%" width="160%" height="160%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="11" result="n2"/>
                  <feDisplacementMap in="SourceGraphic" in2="n2" scale="6.5"/>
                </filter>

                <path id="stampArcTop" d="M 34,118 A 76,76 0 0 1 186,118" fill="none"/>
              </defs>

              <g filter="url(#stampInkCoarse)" class="order-stamp__rings">
                <circle cx="110" cy="110" r="96"/>
                <circle cx="110" cy="110" r="82" class="order-stamp__ring--dashed"/>
              </g>

              <g filter="url(#stampInkFine)" class="order-stamp__ink">
                <text class="order-stamp__arc-text">
                  <textPath href="#stampArcTop" startOffset="50%" text-anchor="middle">★ RJ PRINTING HUB ★</textPath>
                </text>
                <text x="110" y="118" text-anchor="middle" class="order-stamp__headline">ORDER CONFIRMED</text>
              </g>
            </svg>
          </div>
        </div>
        </div>

        <table class="confirmation__table">
          <tr><td>Service</td><td id="serviceName"></td></tr>
          <tr><td>Quantity</td><td id="quantity"></td></tr>
          <tr><td>Fulfillment</td><td id="fulfillment"></td></tr>
          <tr><td>Estimated price</td><td id="priceEstimate"></td></tr>
          <tr><td>Status</td><td><span id="orderStatus" class="status-pill"></span></td></tr>
          <tr><td>Payment</td><td>Pay on pickup/delivery</td></tr>
        </table>

        <div id="notesSection" style="display:none;">
          <h3>Special instructions</h3>
          <p id="specialInstructions"></p>
        </div>

        <div class="confirmation__bottom">
          <a href="/services" class="btn btn--outline">Place Another Order</a>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>


  <script>
    window.__ORDER_ID__ = <%- JSON.stringify(orderId) %>;
  </script>
  <script src="/js/order-confirmation.js"></script>
</body>
</html>
