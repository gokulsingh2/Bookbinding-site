<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us — Book Binding Co.</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner section__inner--narrow">
      <h1>Get in Touch</h1>
      <p class="section__subtitle">Questions about a service, a custom job, or an existing order? Reach out.</p>

      <div class="contact-info">
        <p><strong>📍 Visit us:</strong> Shop 12, MG Road, your city</p>
        <p><strong>🕐 Hours:</strong> Mon–Sat, 10am–7pm</p>
        <p>
          <strong>💬 WhatsApp:</strong>
          <a href="https://wa.me/910000000000" target="_blank" rel="noopener">Message us directly</a>
          <span style="color:#999; font-size:0.85rem;"> (update this number in views/contact.ejs)</span>
        </p>
      </div>

      <h2 class="admin-section-title">Send a Message</h2>
      <form id="contactForm" class="order-form">
        <label for="name">Name</label>
        <input type="text" id="name" required />
        <label for="email">Email</label>
        <input type="email" id="email" required />
        <label for="message">Message</label>
        <textarea id="message" rows="5" required></textarea>
        <button type="submit" class="btn btn--primary">Send Message</button>
      </form>
      <div id="result"></div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/contact.js"></script>
</body>
</html>
