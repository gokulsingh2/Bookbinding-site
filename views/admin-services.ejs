<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Services — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css?v=33" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="admin-body">
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">

      <div id="loadingState"><p>Loading services…</p></div>
      <div id="accessDenied" class="order-form__notice" style="display:none;">
        <p>Admin access required.</p>
        <a href="/login" class="btn btn--primary">Log in</a>
      </div>

      <div id="servicesContent" style="display:none;">
        <h1>Manage Services</h1>

        <h2 class="admin-section-title">Add a Service</h2>
        <form id="addServiceForm" class="order-form">
          <div class="order-form__row">
            <div>
              <label for="name">Name</label>
              <input type="text" id="name" required />
            </div>
            <div>
              <label for="basePrice">Base price (₹)</label>
              <input type="number" id="basePrice" min="0" step="0.01" required />
            </div>
          </div>
          <label for="description">Description</label>
          <textarea id="description" rows="2"></textarea>
          <div class="order-form__row">
            <div>
              <label for="priceNote">Price note (optional)</label>
              <input type="text" id="priceNote" placeholder="e.g. per book" />
            </div>
            <div>
              <label for="turnaroundDays">Turnaround (days)</label>
              <input type="number" id="turnaroundDays" min="1" value="3" />
            </div>
          </div>
          <label for="serviceImage">Photo (optional)</label>
          <input type="file" id="serviceImage" accept=".jpg,.jpeg,.png,.webp,.gif" />
          <p id="serviceImageStatus" class="item-editor__file-status"></p>
          <button type="submit" class="btn btn--primary">Add Service</button>
        </form>
        <div id="addResult"></div>

        <h2 class="admin-section-title">All Services</h2>
        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr><th>Image</th><th>Name</th><th>Price</th><th>Turnaround</th><th>Status</th><th>Actions</th></tr>
            </thead>
            <tbody id="servicesBody"></tbody>
          </table>
        </div>
      </div>

      <div class="item-editor-overlay" id="editServiceOverlay">
        <div class="item-editor" role="dialog" aria-modal="true" aria-labelledby="editServiceTitle">
          <div class="item-editor__head">
            <h2 id="editServiceTitle">Edit Service</h2>
            <button type="button" class="item-editor__close" id="editServiceClose" aria-label="Close">&times;</button>
          </div>
          <form id="editServiceForm" class="order-form">
            <input type="hidden" id="editServiceId" />
            <div class="order-form__row">
              <div>
                <label for="editName">Name</label>
                <input type="text" id="editName" required />
              </div>
              <div>
                <label for="editBasePrice">Base price (₹)</label>
                <input type="number" id="editBasePrice" min="0" step="0.01" required />
              </div>
            </div>
            <label for="editDescription">Description</label>
            <textarea id="editDescription" rows="2"></textarea>
            <div class="order-form__row">
              <div>
                <label for="editPriceNote">Price note (optional)</label>
                <input type="text" id="editPriceNote" placeholder="e.g. per book" />
              </div>
              <div>
                <label for="editTurnaroundDays">Turnaround (days)</label>
                <input type="number" id="editTurnaroundDays" min="1" />
              </div>
            </div>
            <label for="editServiceImage">Photo</label>
            <img id="editCurrentImage" alt="Current photo" style="display:none; width:100%; max-height:160px; object-fit:cover; border-radius:6px; margin-bottom:8px;" />
            <input type="file" id="editServiceImage" accept=".jpg,.jpeg,.png,.webp,.gif" />
            <p id="editServiceImageStatus" class="item-editor__file-status"></p>
            <button type="button" id="editServiceImageRemove" class="btn btn--small btn--outline" style="display:none; margin-top:8px;">Remove photo</button>
            <div class="item-editor__actions">
              <button type="button" class="btn btn--outline" id="editServiceCancel">Cancel</button>
              <button type="submit" class="btn btn--primary">Save Changes</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/admin-services.js"></script>
</body>
</html>
