<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reset Password — Book Binding Co.</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div class="auth-page">
    <h2>Choose a new password</h2>

    <form id="resetForm">
      <label>New password</label>
      <input type="password" id="password" minlength="6" required />
      <label>Confirm new password</label>
      <input type="password" id="confirmPassword" minlength="6" required />
      <button type="submit">Reset password</button>
    </form>

    <div id="result"></div>
  </div>

  <script>
    const token = <%- JSON.stringify(token) %>;

    document.getElementById('resetForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = document.getElementById('password').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const resultEl = document.getElementById('result');

      if (password !== confirmPassword) {
        resultEl.textContent = "Passwords don't match";
        resultEl.className = 'err';
        return;
      }

      try {
        const res = await fetch(`/api/auth/reset-password/${token}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        const data = await res.json();
        resultEl.textContent = data.message || data.error;
        resultEl.className = res.ok ? 'ok' : 'err';

        if (res.ok) {
          setTimeout(() => { window.location.href = '/test-auth.html'; }, 2000);
        }
      } catch (err) {
        resultEl.textContent = 'Something went wrong. Please try again.';
        resultEl.className = 'err';
      }
    });
  </script>
</body>
</html>
