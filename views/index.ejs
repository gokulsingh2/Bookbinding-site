<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RJ Printing Hub — Thesis, Book & Poster Printing</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="hero hero--split">
    <div class="hero__inner">
      <div class="hero__content">
        <span class="hero__eyebrow">Campus Printing &amp; Binding</span>
        <h1 class="hero__headline">
          Bound right.<br>
          Delivered on time.<br>
          Every single order.
        </h1>
        <p class="hero__lede">Thesis binding, book printing, and large-format posters — made to your university's exact spec, with a 3-day turnaround you can actually count on.</p>
        <div class="hero__cta-row">
          <a href="/services" class="btn hero__btn-primary">Start My Order <span aria-hidden="true">→</span></a>
          <a href="/gallery" class="hero__btn-link">View Our Work <span aria-hidden="true">→</span></a>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__photo-wrap">
          <img src="/images/hero-binding.jpg" alt="Thesis being bound at RJ Printing Hub" class="hero__photo" loading="eager" onerror="this.onerror=null;this.src='/images/hero-fallback.svg';" />
          <div class="hero__badge">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M12 7v5l3.5 2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>3-day<br>turnaround</span>
          </div>
        </div>

        <div class="hero__stat-card">
          <p class="hero__stat-number">500+</p>
          <p class="hero__stat-label">theses, books &amp; posters printed for students and researchers on campus</p>
        </div>

        <div class="hero__feature-card">
          <div class="hero__feature-text">
            <span class="hero__feature-eyebrow">— University-Spec Binding</span>
            <p class="hero__feature-title">Every copy matches your submission guidelines</p>
          </div>
          <div class="hero__feature-bars" aria-hidden="true">
            <span style="--h:38%"></span>
            <span style="--h:58%"></span>
            <span style="--h:78%"></span>
            <span style="--h:100%"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section__inner">
      <h2>Featured Services</h2>

      <% if (services && services.length > 0) { %>
        <div class="card-grid">
          <% services.slice(0, 3).forEach(function(service) {
            let cat = 'other', catLabel = 'Printing', cover = '/images/services/printing.jpg'; let coverFallback = '/images/cover-other.svg';
            let icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h8l4 4v14a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M14 3v4h4"/></svg>';
            if (service.slug.includes('thesis')) {
              cat = 'thesis'; catLabel = 'Thesis'; cover = '/images/services/thesis.jpg'; coverFallback = '/images/cover-thesis.svg';
              icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 9l10-5 10 5-10 5-10-5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>';
            } else if (service.slug.includes('book')) {
              cat = 'books'; catLabel = 'Books'; cover = '/images/services/books.jpg'; coverFallback = '/images/cover-books.svg';
              icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v16h5.5c.8 0 1.5-.7 1.5-1.5v-13z"/></svg>';
            } else if (service.slug.includes('poster')) {
              cat = 'posters'; catLabel = 'Posters'; cover = '/images/services/posters.jpg'; coverFallback = '/images/cover-posters.svg';
              icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 16l-5.5-5.5a1 1 0 00-1.4 0L6 19"/></svg>';
            }
          %>
            <a href="/services/<%= service.slug %>" class="service-card service-card--<%= cat %>">
              <div class="service-card__cover">
                <img src="<%= cover %>" alt="<%= catLabel %> service" loading="lazy" onerror="this.onerror=null;this.src='<%= coverFallback %>';" />
                <span class="service-card__tag"><%= catLabel %></span>
              </div>
              <span class="service-card__icon"><%- icon %></span>
              <div class="service-card__body">
                <h3><%= service.name %></h3>
                <p><%= service.description %></p>
                <% if (Number(service.base_price) > 0) { %>
                  <p class="service-card__price">₹<%= Number(service.base_price).toFixed(2) %></p>
                <% } else { %>
                  <p class="service-card__price service-card__price--quote">Price on request</p>
                <% } %>
              </div>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p>Services coming soon.</p>
      <% } %>

      <div class="section__cta">
        <a href="/services" class="btn btn--outline">View All Services</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
