<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RJ Printing Hub — Thesis, Book & Poster Printing</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="hero">
    <div class="hero__inner">
      <h1>Thesis, books & posters — printed and bound right.</h1>
      <p>PhD, Master's & project thesis binding, book binding, and large-format poster printing — B&amp;W or color, any paper size.</p>
      <a href="/services" class="btn btn--primary">Explore Our Services</a>
    </div>
  </section>

  <section class="section">
    <div class="section__inner">
      <h2>Featured Services</h2>

      <% if (services && services.length > 0) { %>
        <div class="card-grid">
          <% services.slice(0, 3).forEach(function(service) { %>
            <a href="/services/<%= service.slug %>" class="service-card">
              <h3><%= service.name %></h3>
              <p><%= service.description %></p>
              <p class="service-card__price">
                ₹<%= Number(service.base_price).toFixed(2) %>
                <% if (service.price_note) { %><span><%= service.price_note %></span><% } %>
              </p>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p>Services coming soon.</p>
      <% } %>

      <div class="section__cta">
        <a href="/services" class="btn btn--outline">View All Services</a>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
