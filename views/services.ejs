<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Services — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">
      <h1>Our Services</h1>
      <p class="section__subtitle">Every binding is made to order, by hand.</p>

      <% if (services && services.length > 0) { %>
        <div class="card-grid">
          <% services.forEach(function(service) { %>
            <a href="/services/<%= service.slug %>" class="service-card">
              <h3><%= service.name %></h3>
              <p><%= service.description %></p>
              <p class="service-card__price">
                ₹<%= Number(service.base_price).toFixed(2) %>
                <% if (service.price_note) { %><span><%= service.price_note %></span><% } %>
              </p>
              <p class="service-card__turnaround">Typical turnaround: <%= service.turnaround_days %> day<%= service.turnaround_days === 1 ? '' : 's' %></p>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p>No services available right now — please check back soon.</p>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
