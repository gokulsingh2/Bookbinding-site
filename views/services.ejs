<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Our Services — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">
      <h1>Our Services</h1>
      <p class="section__subtitle section__subtitle--script">Every binding is made to order, by hand.</p>
      <div class="section__divider" aria-hidden="true"></div>

      <div class="trust-bar">
        <div class="trust-bar__item">
          <span class="trust-bar__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M8 12l-2 8 6-3 6 3-2-8"/></svg></span>
          <span class="trust-bar__label">Made to order,<br>every time</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 9l10-5 10 5-10 5-10-5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg></span>
          <span class="trust-bar__label">University-spec<br>thesis binding</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8l-9-5-9 5 9 5 9-5z"/><path d="M3 8v8l9 5 9-5V8"/><path d="M12 13v8"/></svg></span>
          <span class="trust-bar__label">Pickup or<br>local delivery</span>
        </div>
        <div class="trust-bar__item">
          <span class="trust-bar__icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 9V3h12v6"/><rect x="4" y="9" width="16" height="7" rx="1"/><path d="M8 16h8v5H8z"/></svg></span>
          <span class="trust-bar__label">B&amp;W or full<br>color printing</span>
        </div>
      </div>

      <% if (services && services.length > 0) { %>
        <div class="card-grid">
          <% services.forEach(function(service) {
            let cat = 'other', catLabel = 'Printing';
            let icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h8l4 4v14a1 1 0 01-1 1H6a1 1 0 01-1-1V4a1 1 0 011-1z"/><path d="M14 3v4h4"/></svg>';
            if (service.slug.includes('thesis')) {
              cat = 'thesis'; catLabel = 'Thesis';
              icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M2 9l10-5 10 5-10 5-10-5z"/><path d="M6 11v5c0 1.5 2.7 3 6 3s6-1.5 6-3v-5"/></svg>';
            } else if (service.slug.includes('book')) {
              cat = 'books'; catLabel = 'Books';
              icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5.5C4 4.7 4.7 4 5.5 4H11v16H5.5C4.7 20 4 19.3 4 18.5v-13z"/><path d="M20 5.5c0-.8-.7-1.5-1.5-1.5H13v16h5.5c.8 0 1.5-.7 1.5-1.5v-13z"/></svg>';
            } else if (service.slug.includes('poster')) {
              cat = 'posters'; catLabel = 'Posters';
              icon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="4" width="18" height="16" rx="1.5"/><circle cx="8.5" cy="9.5" r="1.5"/><path d="M21 16l-5.5-5.5a1 1 0 00-1.4 0L6 19"/></svg>';
            }
          %>
            <a href="/services/<%= service.slug %>" class="service-card service-card--<%= cat %>">
              <div class="service-card__top">
                <span class="service-card__icon"><%- icon %></span>
                <span class="service-card__tag"><%= catLabel %></span>
              </div>
              <h3><%= service.name %></h3>
              <p><%= service.description %></p>
              <div class="service-card__footer">
                <% if (Number(service.base_price) > 0) { %>
                  <p class="service-card__price">₹<%= Number(service.base_price).toFixed(2) %></p>
                <% } else { %>
                  <p class="service-card__price service-card__price--quote">Price on request</p>
                <% } %>
                <p class="service-card__turnaround">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
                  <%= service.turnaround_days %> day<%= service.turnaround_days === 1 ? '' : 's' %>
                </p>
              </div>
            </a>
          <% }); %>
        </div>
      <% } else { %>
        <p>No services available right now — please check back soon.</p>
      <% } %>
    </div>
  </section>

  <%- include('partials/footer') %>
</body>
</html>
