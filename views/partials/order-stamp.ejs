<div class="order-stamp" id="orderStamp" aria-hidden="true">
  <span class="order-stamp__bleed order-stamp__bleed--1"></span>
  <span class="order-stamp__bleed order-stamp__bleed--2"></span>
  <span class="order-stamp__bleed order-stamp__bleed--3"></span>
  <span class="order-stamp__shock"></span>
  <svg viewBox="0 0 220 220" class="order-stamp__svg">
    <defs>
      <filter id="stampInkFine" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" seed="7" result="n1"/>
        <feDisplacementMap in="SourceGraphic" in2="n1" scale="1.4"/>
      </filter>
      <filter id="stampInkCoarse" x="-30%" y="-30%" width="160%" height="160%">
        <feTurbulence type="fractalNoise" baseFrequency="0.045" numOctaves="3" seed="11" result="n2"/>
        <feDisplacementMap in="SourceGraphic" in2="n2" scale="6.5"/>
      </filter>
      <path id="stampArcTop" d="M 34,118 A 76,76 0 0 1 186,118" fill="none"/>
    </defs>

    <g filter="url(#stampInkCoarse)" class="order-stamp__rings">
      <circle cx="110" cy="110" r="96"/>
      <circle cx="110" cy="110" r="82" class="order-stamp__ring--dashed"/>
    </g>

    <g filter="url(#stampInkFine)" class="order-stamp__ink">
      <text class="order-stamp__arc-text">
        <textPath href="#stampArcTop" startOffset="50%" text-anchor="middle">★ RJ PRINTING HUB ★</textPath>
      </text>
      <text x="110" y="112" text-anchor="middle" class="order-stamp__headline">ORDER CONFIRMED</text>
      <line x1="55" y1="126" x2="165" y2="126" class="order-stamp__rule"/>
      <text x="110" y="152" text-anchor="middle" id="stampOrderNumber" class="order-stamp__order-no"></text>
    </g>
  </svg>
</div>
