<div id="pageTransition" class="page-transition" aria-hidden="true">
  <div class="loader">
    <span class="loader__ring"></span>
    <span class="loader__blob"></span>
    <span class="loader__orbit">
      <span class="loader__spark"></span>
    </span>
  </div>
</div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-logo" aria-label="RJ Printing Hub — home">
      <svg class="logo-svg" width="270" height="46" viewBox="0 0 680 113" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="RJ Printing Hub">
        <defs>
          <style>@import url('https://fonts.googleapis.com/css2?family=Caveat:wght@700&amp;display=swap');</style>
          <linearGradient id="logoCoverGrad" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="#8a63f5"/>
            <stop offset="55%" stop-color="#5b3fd6"/>
            <stop offset="100%" stop-color="#3c2a99"/>
          </linearGradient>
          <linearGradient id="logoTextGrad" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#5b3fd6"/>
            <stop offset="100%" stop-color="#8a63f5"/>
          </linearGradient>
          <radialGradient id="logoGlow" cx="50%" cy="50%" r="50%">
            <stop offset="0%" stop-color="#ff6f59" stop-opacity="0.55"/>
            <stop offset="100%" stop-color="#ff6f59" stop-opacity="0"/>
          </radialGradient>
        </defs>

        <g class="logo-mark">
          <!-- soft hover glow behind the book -->
          <circle class="logo-glow" cx="99" cy="63" r="58" fill="url(#logoGlow)"/>

          <!-- back pages -->
          <g class="logo-pages">
            <rect x="60" y="47" width="70" height="48" rx="4" fill="#ddccf0" stroke="#7c5cf0" stroke-width="1"/>
            <rect x="64" y="42" width="70" height="48" rx="4" fill="#f4eefb" stroke="#7c5cf0" stroke-width="1"/>
          </g>

          <!-- front cover -->
          <g class="logo-cover">
            <rect x="68" y="37" width="70" height="48" rx="4" fill="url(#logoCoverGrad)" stroke="#3c2a99" stroke-width="1.5"/>
            <rect x="76" y="47" width="54" height="6" rx="1.5" fill="#ffffff"/>
            <rect x="76" y="57" width="42" height="3" rx="1" fill="#ffffff" opacity="0.75"/>
            <rect x="76" y="64" width="32" height="3" rx="1" fill="#ffffff" opacity="0.55"/>
          </g>

          <!-- quill writing across the cover -->
          <g class="logo-quill">
            <path d="M120 30 C 128 22, 140 20, 146 12 C 140 20, 138 32, 130 40 C 126 44, 121 42, 120 38 Z"
                  fill="#ff6f59" stroke="#e2543f" stroke-width="1"/>
            <line x1="120" y1="38" x2="103" y2="55" stroke="#e2543f" stroke-width="2" stroke-linecap="round"/>
            <path class="logo-quill-ink" d="M100 58 C 96 60, 93 63, 90 62 C 87 61, 89 57, 92 57 C 95 57, 95 61, 92 62"
                  fill="none" stroke="#ff6f59" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/>
          </g>

          <!-- sparkles -->
          <path class="logo-spark logo-spark--1" d="M148 18 L150.5 24 L157 26.5 L150.5 29 L148 35 L145.5 29 L139 26.5 L145.5 24 Z" fill="#ffd166"/>
          <path class="logo-spark logo-spark--2" d="M56 30 L57.6 33.6 L61.2 35.2 L57.6 36.8 L56 40.4 L54.4 36.8 L50.8 35.2 L54.4 33.6 Z" fill="#ff6f59"/>
        </g>

        <text x="160" y="76" font-family="'Caveat', cursive" font-weight="700" font-size="42" fill="url(#logoTextGrad)" class="logo-text">RJ Printing Hub</text>
      </svg>
    </a>
    <nav class="site-nav">
      <a href="/">Home</a>
      <a href="/services">Services</a>
      <a href="/gallery">Gallery</a>
      <a href="/contact">Contact</a>
    </nav>
    <div class="site-nav__auth">
      <a href="/cart" class="site-nav__cart" id="cartLink" aria-label="Go to checkout">
        <svg id="cartIcon" class="cart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M2 3h2l.6 3M4.6 6h15.4l-1.8 7.5a1.5 1.5 0 01-1.46 1.15H7.9a1.5 1.5 0 01-1.47-1.2L4.6 6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/>
          <path d="M7.6 9.4h11.4M8.5 12.4h9.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
          <circle cx="9.4" cy="19" r="1.5" fill="currentColor"/>
          <circle cx="16.8" cy="19" r="1.5" fill="currentColor"/>
        </svg>
        <span id="cartCount" class="cart-badge" style="display:none;">0</span>
      </a>
      <a href="/my-orders" class="btn btn--small btn--outline">My Orders</a>
      <a href="/login" class="btn btn--small">My Account</a>
    </div>
  </div>
</header>

<script src="/js/cart.js"></script>
