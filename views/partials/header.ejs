<div id="pageTransition" class="page-transition" aria-hidden="true">
  <div class="loader-book">
    <span class="loader-book__spine"></span>
    <span class="loader-book__page loader-book__page--1"></span>
    <span class="loader-book__page loader-book__page--2"></span>
  </div>
</div>

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-logo" aria-label="RJ Printing Hub — home">
      <svg class="logo-svg" width="370" height="61" viewBox="0 0 680 113" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="RJ Printing Hub">
        <defs>
          <linearGradient id="bookSpineGrad1" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#132a52"/>
            <stop offset="100%" stop-color="#0b1830"/>
          </linearGradient>
          <linearGradient id="bookSpineGrad2" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#1c3f7a"/>
            <stop offset="100%" stop-color="#132a52"/>
          </linearGradient>
          <linearGradient id="bookSpineGrad3" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0%" stop-color="#3f6fe0"/>
            <stop offset="100%" stop-color="#2148ad"/>
          </linearGradient>
        </defs>

        <!-- a real stack of hardcover books: thick spines at back, fanned page-block up front -->
        <g>
          <!-- back book (bottom of the pile, biggest) -->
          <g transform="rotate(-3 90 84)">
            <rect x="18" y="68" width="20" height="32" rx="2" fill="url(#bookSpineGrad1)"/>
            <rect x="36" y="66" width="120" height="34" rx="3" fill="#eef1f9"/>
            <line x1="42" y1="72" x2="152" y2="72" stroke="#c9d2e8" stroke-width="1.5"/>
            <line x1="42" y1="79" x2="152" y2="79" stroke="#c9d2e8" stroke-width="1.5"/>
            <line x1="42" y1="86" x2="152" y2="86" stroke="#c9d2e8" stroke-width="1.5"/>
            <line x1="42" y1="93" x2="152" y2="93" stroke="#c9d2e8" stroke-width="1.5"/>
          </g>

          <!-- middle book -->
          <g transform="rotate(2 84 62)">
            <rect x="14" y="47" width="20" height="29" rx="2" fill="url(#bookSpineGrad2)"/>
            <rect x="32" y="45" width="108" height="31" rx="3" fill="#f4f6fb"/>
            <line x1="38" y1="51" x2="136" y2="51" stroke="#d3daea" stroke-width="1.4"/>
            <line x1="38" y1="58" x2="136" y2="58" stroke="#d3daea" stroke-width="1.4"/>
            <line x1="38" y1="65" x2="136" y2="65" stroke="#d3daea" stroke-width="1.4"/>
            <line x1="38" y1="72" x2="136" y2="72" stroke="#d3daea" stroke-width="1.4"/>
          </g>

          <!-- front book (top of the pile, brightest) -->
          <g transform="rotate(-2 78 38)">
            <rect x="10" y="24" width="20" height="27" rx="2" fill="url(#bookSpineGrad3)"/>
            <rect x="28" y="22" width="96" height="29" rx="3" fill="#ffffff"/>
            <line x1="34" y1="28" x2="118" y2="28" stroke="#dde4f2" stroke-width="1.3"/>
            <line x1="34" y1="35" x2="118" y2="35" stroke="#dde4f2" stroke-width="1.3"/>
            <line x1="34" y1="42" x2="118" y2="42" stroke="#dde4f2" stroke-width="1.3"/>
            <line x1="34" y1="49" x2="118" y2="49" stroke="#dde4f2" stroke-width="1.3"/>
          </g>

          <!-- binding ribbon draped across the pile -->
          <rect x="80" y="14" width="9" height="92" rx="3" fill="#0b1830" opacity="0.88" transform="rotate(4 84 60)"/>
          <line x1="82" y1="20" x2="87" y2="100" stroke="#3f6fe0" stroke-width="1" opacity="0.6" transform="rotate(4 84 60)"/>
        </g>

        <text x="185" y="76" font-family="Arial, Helvetica, sans-serif" font-weight="800" font-size="40">
          <tspan fill="#14213d">RJ </tspan>
          <tspan fill="#2b57c9">Printing </tspan>
          <tspan fill="#14213d">Hub</tspan>
        </text>
      </svg>
    </a>
    <% if (typeof isAdminPage !== 'undefined' && isAdminPage) { %>
      <nav class="admin-header-nav" id="adminHeaderNav">
        <a href="/admin" data-path="/admin" class="admin-header-nav__item admin-header-nav__item--violet" title="Dashboard">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>
          <span>Dashboard</span>
        </a>
        <a href="/admin/orders" data-path="/admin/orders" class="admin-header-nav__item admin-header-nav__item--blue" title="Orders">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2V3z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>
          <span>Orders</span>
        </a>
        <a href="/admin/services" data-path="/admin/services" class="admin-header-nav__item admin-header-nav__item--coral" title="Services">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20.6 12.9l-7.7 7.7a2 2 0 01-2.8 0L3.4 14a2 2 0 010-2.8L11.1 3.5a2 2 0 011.4-.6H19a2 2 0 012 2v6.6a2 2 0 01-.4 1.3z"/><circle cx="15.5" cy="8.5" r="1.5"/></svg>
          <span>Services</span>
        </a>
        <a href="/admin/gallery" data-path="/admin/gallery" class="admin-header-nav__item admin-header-nav__item--teal" title="Gallery">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5-4 4-3-3-6 6"/></svg>
          <span>Gallery</span>
        </a>
        <a href="/admin/analytics" data-path="/admin/analytics" class="admin-header-nav__item admin-header-nav__item--green" title="Analytics">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12.5" y="8" width="3" height="10"/><rect x="18" y="5" width="3" height="13"/></svg>
          <span>Analytics</span>
        </a>
        <a href="/admin/messages" data-path="/admin/messages" class="admin-header-nav__item admin-header-nav__item--amber" title="Messages">
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg>
          <span>Messages</span>
        </a>
      </nav>
      <script>
        (function () {
          var path = window.location.pathname.replace(/\/$/, '') || '/admin';
          document.querySelectorAll('#adminHeaderNav a').forEach(function (a) {
            var target = a.getAttribute('data-path');
            var isMatch = target === '/admin' ? path === '/admin' : path.indexOf(target) === 0;
            if (isMatch) a.classList.add('is-active');
          });
        })();
      </script>
    <% } else { %>
      <nav class="site-nav">
        <a href="/">Home</a>
        <a href="/services">Services</a>
        <a href="/gallery">Gallery</a>
        <a href="/contact">Contact</a>
      </nav>
    <% } %>
    <div class="site-nav__auth" id="siteNavAuth">
      <!-- Logged out: just a single Log in button. Cart/orders/account stay hidden
           until account.js confirms a session — see public/js/account.js. -->
      <a href="/login" id="loggedOutAuth" class="btn btn--small" style="display:none;">Log in</a>

      <div id="loggedInAuth" class="loggedin-auth" style="display:none;">
        <% if (typeof isAdminPage !== 'undefined' && isAdminPage) { %>
          <span id="adminWelcomeNote" class="admin-welcome-note"></span>
        <% } else { %>
          <a href="/cart" class="site-nav__cart" id="cartLink" aria-label="Go to checkout">
            <svg id="cartIcon" class="cart-icon" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M2 3h2l.6 3M4.6 6h15.4l-1.8 7.5a1.5 1.5 0 01-1.46 1.15H7.9a1.5 1.5 0 01-1.47-1.2L4.6 6z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/>
              <path d="M7.6 9.4h11.4M8.5 12.4h9.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>
              <circle cx="9.4" cy="19" r="1.5" fill="currentColor"/>
              <circle cx="16.8" cy="19" r="1.5" fill="currentColor"/>
            </svg>
            <span id="cartCount" class="cart-badge" style="display:none;">0</span>
          </a>
        <% } %>

        <div class="account-menu" id="accountMenu">
          <button type="button" class="account-menu__trigger" id="accountTrigger" aria-haspopup="true" aria-expanded="false">
            <span class="account-menu__avatar" id="accountAvatar"></span>
            <svg class="account-menu__chevron" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>

          <div class="account-menu__dropdown" id="accountDropdown">
            <div class="account-menu__info">
              <span class="account-menu__info-name" id="accountDropdownName"></span>
              <span class="account-menu__info-email" id="accountDropdownEmail"></span>
            </div>
            <a href="/profile" class="account-menu__item">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              Profile
            </a>
            <a href="/my-orders" class="account-menu__item">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M3 7l9-4 9 4-9 4-9-4zm0 0v10l9 4 9-4V7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round"/></svg>
              My Orders
            </a>
            <% if (!(typeof isAdminPage !== 'undefined' && isAdminPage)) { %>
            <a href="/admin" class="account-menu__item" id="adminDashboardLink" style="display:none;">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 13h6V4H4v9zm0 7h6v-5H4v5zm10 0h6v-9h-6v9zm0-16v5h6V4h-6z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
              Admin Dashboard
            </a>
            <% } %>
            <button type="button" class="account-menu__item account-menu__item--logout" id="logoutBtn">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M15 17l5-5-5-5M20 12H9M12 4H6a2 2 0 00-2 2v12a2 2 0 002 2h6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Log out
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script src="/js/cart.js"></script>
<script src="/js/account.js"></script>
