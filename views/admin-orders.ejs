<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Orders — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css?v=33" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body class="admin-body">
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">

      <div id="loadingState"><p>Loading orders…</p></div>
      <div id="accessDenied" class="order-form__notice" style="display:none;">
        <p>Admin access required.</p>
        <a href="/login" class="btn btn--primary">Log in</a>
      </div>

      <div id="ordersContent" style="display:none;">
        <h1>Manage Orders</h1>

        <div class="admin-filters" style="display:flex; align-items:center; gap:18px; flex-wrap:wrap;">
          <select id="statusFilter">
            <option value="">All statuses</option>
            <option value="received">Received</option>
            <option value="in_progress">In Progress</option>
            <option value="ready">Ready</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
          <label class="checkbox-label" style="margin-top:0 !important;">
            <input type="checkbox" id="urgentOnly" />
            Urgent only
          </label>
        </div>

        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr><th>Order #</th><th>Customer</th><th>Service</th><th>Fulfillment</th><th>Flags</th><th>Status</th><th>Price</th><th>Date</th><th></th></tr>
            </thead>
            <tbody id="ordersBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/admin-orders.js"></script>
</body>
</html>
