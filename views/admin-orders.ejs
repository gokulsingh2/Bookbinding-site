<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Manage Orders — Book Binding Co.</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner">
      <%- include('partials/admin-nav') %>

      <div id="loadingState"><p>Loading orders…</p></div>
      <div id="accessDenied" class="order-form__notice" style="display:none;">
        <p>Admin access required.</p>
        <a href="/test-auth.html" class="btn btn--primary">Log in</a>
      </div>

      <div id="ordersContent" style="display:none;">
        <h1>Manage Orders</h1>

        <div class="admin-filters">
          <select id="statusFilter">
            <option value="">All statuses</option>
            <option value="received">Received</option>
            <option value="in_progress">In Progress</option>
            <option value="ready">Ready</option>
            <option value="delivered">Delivered</option>
            <option value="cancelled">Cancelled</option>
          </select>
        </div>

        <div class="admin-table-wrapper">
          <table class="admin-table">
            <thead>
              <tr><th>Order #</th><th>Customer</th><th>Service</th><th>Fulfillment</th><th>Status</th><th>Price</th><th>Date</th></tr>
            </thead>
            <tbody id="ordersBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/admin-orders.js"></script>
</body>
</html>
