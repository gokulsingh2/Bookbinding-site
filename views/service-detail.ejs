<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= service.name %> — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css?v=33" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner section__inner--narrow">
      <a href="/services" class="back-link">&larr; All services</a>

      <% if (service.image_url) { %>
        <div class="service-detail__image">
          <img src="<%= service.image_url %>" alt="<%= service.name %>" loading="lazy" />
        </div>
      <% } %>

      <h1><%= service.name %></h1>
      <p class="service-detail__price">
        ₹<%= Number(service.base_price).toFixed(2) %>
        <% if (service.price_note) { %><span><%= service.price_note %></span><% } %>
      </p>
      <p class="service-detail__turnaround">Typical turnaround: <%= service.turnaround_days %> day<%= service.turnaround_days === 1 ? '' : 's' %></p>

      <div class="service-detail__description">
        <p><%= service.description %></p>
      </div>

      <button
        type="button"
        class="btn btn--primary add-to-cart-btn"
        data-service-id="<%= service.id %>"
        data-service-name="<%= service.name %>"
        data-base-price="<%= service.base_price %>"
        data-price-note="<%= service.price_note || '' %>"
      >
        Add to Cart
      </button>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/services-add-to-cart.js"></script>
</body>
</html>
