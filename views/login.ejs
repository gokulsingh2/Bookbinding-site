<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log In — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="auth-page">
      <div class="tabs">
        <button type="button" id="tabLogin" class="active" onclick="showTab('login')">Log In</button>
        <button type="button" id="tabRegister" onclick="showTab('register')">Register</button>
      </div>

      <form id="loginForm">
        <h2>Welcome back</h2>
        <label for="loginEmail">Email</label>
        <input type="email" id="loginEmail" required autocomplete="email" />
        <label for="loginPassword">Password</label>
        <input type="password" id="loginPassword" required autocomplete="current-password" />
        <button type="submit">Log in</button>
        <p style="text-align:center; margin-top:12px;">
          <a href="/forgot-password" style="color:var(--leather); font-size:0.85rem;">Forgot your password?</a>
        </p>
        <div id="loginResult"></div>
      </form>

      <form id="registerForm" style="display:none">
        <h2>Create your account</h2>
        <label for="regName">Name</label>
        <input type="text" id="regName" required autocomplete="name" />
        <label for="regEmail">Email</label>
        <input type="email" id="regEmail" required autocomplete="email" />
        <label for="regPhone">Phone (optional)</label>
        <input type="tel" id="regPhone" autocomplete="tel" />
        <label for="regPassword">Password</label>
        <input type="password" id="regPassword" required minlength="6" autocomplete="new-password" />
        <button type="submit">Create account</button>
        <div id="registerResult"></div>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    window.__REDIRECT_TO__ = <%- JSON.stringify(redirectTo || '/') %>;
  </script>
  <script src="/js/login.js"></script>
</body>
</html>
