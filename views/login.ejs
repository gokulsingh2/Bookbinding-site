<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log In — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section auth-section">
    <div class="auth-page">
      <div class="auth-page__brand">
        <svg viewBox="0 0 100 100" class="auth-page__icon" aria-hidden="true">
          <circle cx="50" cy="50" r="46" fill="#170f26" opacity="0.06"/>
          <path d="M50 20 L28 26 C24 27 22 30 22 35 L22 62 C22 66 24 69 28 70 L50 76 Z" fill="#5b3fd6"/>
          <path d="M50 20 L72 26 C76 27 78 30 78 35 L78 62 C78 66 76 69 72 70 L50 76 Z" fill="#ff6f59"/>
          <line x1="30" y1="38" x2="43" y2="41" stroke="#ffffff" stroke-width="1.6" opacity="0.6"/>
          <line x1="30" y1="46" x2="41" y2="49" stroke="#ffffff" stroke-width="1.6" opacity="0.5"/>
          <line x1="57" y1="41" x2="70" y2="38" stroke="#ffffff" stroke-width="1.6" opacity="0.6"/>
          <line x1="59" y1="49" x2="70" y2="46" stroke="#ffffff" stroke-width="1.6" opacity="0.5"/>
        </svg>
      </div>

      <span class="eyebrow auth-page__eyebrow"><span class="eyebrow__dot"></span>RJ Printing Hub</span>
      <h2 class="auth-page__welcome" id="authWelcomeHeading">
        <span class="auth-page__letter">W</span><span class="auth-page__letter">e</span><span class="auth-page__letter">l</span><span class="auth-page__letter">c</span><span class="auth-page__letter">o</span><span class="auth-page__letter">m</span><span class="auth-page__letter">e</span>
      </h2>

      <div class="tabs">
        <button type="button" id="tabLogin" class="active" onclick="showTab('login')">Log In</button>
        <button type="button" id="tabRegister" onclick="showTab('register')">Register</button>
      </div>

      <form id="loginForm">
        <label for="loginEmail">Email</label>
        <input type="email" id="loginEmail" required autocomplete="email" />
        <label for="loginPassword">Password</label>
        <input type="password" id="loginPassword" required autocomplete="current-password" />
        <button type="submit">Log in</button>
        <p style="text-align:center; margin-top:12px;">
          <a href="/forgot-password" style="color:var(--leather); font-size:0.85rem;">Forgot your password?</a>
        </p>
        <div id="loginResult"></div>
      </form>

      <form id="registerForm" style="display:none">
        <label for="regName">Name</label>
        <input type="text" id="regName" required autocomplete="name" />
        <label for="regEmail">Email</label>
        <input type="email" id="regEmail" required autocomplete="email" />
        <label for="regPhone">Phone (optional)</label>
        <input type="tel" id="regPhone" autocomplete="tel" />
        <label for="regPassword">Password</label>
        <input type="password" id="regPassword" required minlength="6" autocomplete="new-password" />
        <button type="submit">Create account</button>
        <div id="registerResult"></div>
      </form>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    window.__REDIRECT_TO__ = <%- JSON.stringify(redirectTo || '/') %>;
  </script>
  <script src="/js/login.js"></script>
</body>
</html>
