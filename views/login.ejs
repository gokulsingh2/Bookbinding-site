<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log In — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="auth-shell">
    <div class="auth-shell__grid">

      <aside class="auth-brand">
        <div class="auth-brand__decor" aria-hidden="true">
          <span class="auth-brand__blob auth-brand__blob--1"></span>
          <span class="auth-brand__blob auth-brand__blob--2"></span>
        </div>
        <div class="auth-brand__content">
          <h1 class="auth-brand__title">Bound right.<br>Delivered on time.</h1>
          <p class="auth-brand__text">Thesis binding, book printing &amp; posters — made to your university's exact spec, with a turnaround you can count on.</p>
          <ul class="auth-brand__stats">
            <li><strong>500+</strong><span>orders bound</span></li>
            <li><strong>5-day</strong><span>turnaround</span></li>
          </ul>
        </div>
      </aside>

      <div class="auth-panel">
        <div class="auth-panel__inner">

          <div class="auth-tabs" id="authTabs">
            <span class="auth-tabs__pill" aria-hidden="true"></span>
            <button type="button" id="tabLogin" class="is-active" onclick="showTab('login')">Log In</button>
            <button type="button" id="tabRegister" onclick="showTab('register')">Register</button>
          </div>

          <form id="loginForm" class="auth-form">
            <h2 class="auth-form__title">Welcome back</h2>
            <p class="auth-form__subtitle">Log in to track orders and manage your account.</p>

            <label for="loginEmail">Email</label>
            <div class="auth-input">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <input type="email" id="loginEmail" required autocomplete="email" placeholder="you@example.com" />
            </div>

            <label for="loginPassword">Password</label>
            <div class="auth-input">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              <input type="password" id="loginPassword" required autocomplete="current-password" placeholder="••••••••" />
              <button type="button" class="auth-input__toggle" data-target="loginPassword" aria-label="Show password">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
            </div>

            <div class="auth-form__row">
              <a href="/forgot-password" class="auth-form__link">Forgot your password?</a>
            </div>

            <button type="submit" class="btn auth-submit">Log in</button>
            <div id="loginResult"></div>
          </form>

          <form id="registerForm" class="auth-form" style="display:none">
            <h2 class="auth-form__title">Create your account</h2>
            <p class="auth-form__subtitle">Takes less than a minute.</p>

            <label for="regName">Name</label>
            <div class="auth-input">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="8" r="4" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
              <input type="text" id="regName" required autocomplete="name" placeholder="Your name" />
            </div>

            <label for="regEmail">Email</label>
            <div class="auth-input">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M3 7l9 6 9-6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <input type="email" id="regEmail" required autocomplete="email" placeholder="you@example.com" />
            </div>

            <label for="regPhone">Phone (optional)</label>
            <div class="auth-input">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M4 4h4l2 5-2.5 1.5a12 12 0 006 6L15 14l5 2v4a2 2 0 01-2 2C9.2 22 2 14.8 2 6a2 2 0 012-2z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
              <input type="tel" id="regPhone" autocomplete="tel" placeholder="98765 43210" />
            </div>

            <label for="regPassword">Password</label>
            <div class="auth-input">
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8 10V7a4 4 0 018 0v3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              <input type="password" id="regPassword" required minlength="6" autocomplete="new-password" placeholder="At least 6 characters" />
              <button type="button" class="auth-input__toggle" data-target="regPassword" aria-label="Show password">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
              </button>
            </div>

            <button type="submit" class="btn auth-submit">Create account</button>
            <div id="registerResult"></div>
          </form>

        </div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    window.__REDIRECT_TO__ = <%- JSON.stringify(redirectTo || '/') %>;
  </script>
  <script src="/js/login.js"></script>
</body>
</html>
