<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Checkout — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner section__inner--narrow">

      <div id="loginNotice" class="order-form__notice" style="display:none;">
        <p>You'll need to be logged in to check out your cart.</p>
        <a href="/login?redirect=/cart" class="btn btn--primary">Log in / Register</a>
      </div>

      <div id="cartWrapper" style="display:none;">
        <span class="eyebrow"><span class="eyebrow__dot"></span>Almost There</span>
        <h1><span class="hl">Checkout</span></h1>

        <div id="emptyState" class="cart-empty" style="display:none;">
          <p>You haven't added anything yet — add a service to get started.</p>
          <a href="/services" class="btn btn--primary">Browse Services</a>
        </div>

        <div id="cartContent" style="display:none;">
          <div id="cartItems" class="cart-items"></div>

          <div class="order-form__estimate">
            <span>Total (<span id="itemCount">0</span> item<span id="itemCountPlural">s</span>)</span>
            <strong id="grandTotal">₹0.00</strong>
          </div>

          <form id="checkoutForm" class="order-form">
            <label for="fulfillmentType">Fulfillment</label>
            <select id="fulfillmentType" required>
              <option value="pickup">Pickup</option>
              <option value="local_delivery">Local Delivery</option>
              <option value="shipping">Shipping</option>
            </select>

            <div id="addressField" style="display:none;">
              <label for="deliveryAddress">Delivery address</label>
              <textarea id="deliveryAddress" rows="2" placeholder="Full address for delivery/shipping"></textarea>
            </div>

            <label class="checkbox-label">
              <input type="checkbox" id="isUrgent" />
              This is urgent (rush order) — applies to all items
            </label>

            <div class="order-form__estimate">
              <span>Order total</span>
              <strong id="grandTotalBottom">₹0.00</strong>
            </div>

            <button type="submit" class="btn btn--primary">Place Order</button>
          </form>

          <div id="result"></div>
        </div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>

  <script src="/js/item-editor.js"></script>
  <script src="/js/cart-page.js"></script>
</body>
</html>
