<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Place an Order — RJ Printing Hub</title>
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
</head>
<body>
  <%- include('partials/header') %>

  <section class="section">
    <div class="section__inner section__inner--narrow">

      <div id="loginNotice" class="order-form__notice" style="display:none;">
        <p>You'll need to be logged in to place an order.</p>
        <a href="/test-auth.html" class="btn btn--primary">Log in / Register</a>
      </div>

      <div id="orderFormWrapper" style="display:none;">
        <span class="eyebrow"><span class="eyebrow__dot"></span>Get Started</span>
        <h1>Place an <span class="hl">Order</span></h1>

        <form id="orderForm" class="order-form">
          <label for="serviceSelect">Service</label>
          <select id="serviceSelect" required></select>

          <div class="order-form__row">
            <div>
              <label for="quantity">Quantity</label>
              <input type="number" id="quantity" min="1" value="1" required />
            </div>
            <div>
              <label for="pageCount">Page count (optional)</label>
              <input type="number" id="pageCount" min="1" />
            </div>
          </div>

          <div class="order-form__row">
            <div>
              <label for="paperSize">Paper size</label>
              <select id="paperSize" required>
                <option value="A4">A4</option>
                <option value="A3">A3</option>
                <option value="A2">A2</option>
                <option value="A1">A1</option>
              </select>
            </div>
            <div>
              <label for="printColor">Print color</label>
              <select id="printColor" required>
                <option value="bw">Black &amp; White</option>
                <option value="color">Color</option>
              </select>
            </div>
          </div>

          <div class="order-form__row">
            <div>
              <label for="bindingType">Binding type (leave as None for posters)</label>
              <select id="bindingType">
                <option value="">— None —</option>
                <option value="spiral">Spiral Binding</option>
                <option value="soft_bind">Soft Bind</option>
                <option value="perfect_binding">Perfect Binding</option>
                <option value="digital_embossing">Digital Embossing</option>
                <option value="handmade_embossing">Hand-made Embossing</option>
              </select>
            </div>
            <div>
              <label for="paperQuality">Paper quality</label>
              <select id="paperQuality" required>
                <option value="70gsm">70 GSM</option>
                <option value="85gsm">85 GSM</option>
                <option value="100gsm">100 GSM</option>
                <option value="150gsm">150 GSM</option>
                <option value="200gsm">200 GSM</option>
                <option value="250gsm">250 GSM</option>
                <option value="300gsm">300 GSM</option>
                <option value="glossy">Glossy</option>
              </select>
            </div>
          </div>

          <label for="specialInstructions">Special instructions (optional)</label>
          <textarea id="specialInstructions" rows="3" placeholder="Anything we should know about this order?"></textarea>

          <label for="uploadedFile">Attach your file (optional)</label>
          <input type="file" id="uploadedFile" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.webp,.gif" />
          <p class="field-hint">Upload your thesis PDF, poster design, or document to print. PDF, Word, or image files, up to 25MB.</p>

          <label for="fulfillmentType">Fulfillment</label>
          <select id="fulfillmentType" required>
            <option value="pickup">Pickup</option>
            <option value="local_delivery">Local Delivery</option>
            <option value="shipping">Shipping</option>
          </select>

          <div id="addressField" style="display:none;">
            <label for="deliveryAddress">Delivery address</label>
            <textarea id="deliveryAddress" rows="2" placeholder="Full address for delivery/shipping"></textarea>
          </div>

          <label class="checkbox-label">
            <input type="checkbox" id="isUrgent" />
            This is urgent (rush order)
          </label>

          <div class="order-form__estimate">
            <span>Estimated price</span>
            <strong id="priceEstimate">₹0.00</strong>
          </div>

          <button type="submit" class="btn btn--primary">Place Order</button>
        </form>

        <div id="result"></div>
      </div>

    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    window.__PRESELECTED_SLUG__ = <%- JSON.stringify(preselectedSlug || '') %>;
  </script>
  <script src="/js/order-form.js"></script>
</body>
</html>
